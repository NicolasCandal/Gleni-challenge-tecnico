# Supabase project URL and server-side anon key.
# Find these in your Supabase project settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OpenAI credentials and model. Used only by the backend.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini

# Streaming request timeout in milliseconds. Default: 30000.
OPENAI_TIMEOUT_MS=30000

# Exact frontend origin allowed by CORS.
# Development defaults to http://localhost:5173 if omitted.
CORS_ORIGIN=http://localhost:5173

# Recommendation thresholds, expressed as percentages.
# Signals compare the buy/sell spread and gap against the official dollar rate.
# These are application heuristics; adjust them to suit the intended context.
# Existing deployments can continue using the legacy Spanish variable names.
HIGH_SPREAD_THRESHOLD=2.5
LOW_SPREAD_THRESHOLD=1.5
HIGH_GAP_THRESHOLD=8
LOW_GAP_THRESHOLD=3

# In-memory quote cache lifetime in milliseconds. Default: 45000.
# Interbank reference rates have a separate fixed six-hour cache.
EXCHANGE_CACHE_TTL_MS=45000

# Optional backend port. Default: 3000.
PORT=3000
